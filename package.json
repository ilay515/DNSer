{
  "name": "dnser",
  "version": "1.0.0",
  "description": "DNSer — Minimal offline developer DNS server with web UI, user control, and query logs",
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"tsx watch src/server/index.ts\" \"vite\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "pnpm build:client && pnpm build:server",
    "start": "node dist/server/index.js",
    "test": "e2e run",
    "test:e2e": "e2e run",
    "query": "tsx src/server/cli-query.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.4",
    "@fastify/static": "^8.1.1",
    "dns-packet": "^5.6.1",
    "fastify": "^5.2.1",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@ai-sdk/google": "^4.0.109",
    "@e2e-dev/web": "^0.12.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/dns-packet": "^5.6.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ai": "^7.0.0",
    "concurrently": "^9.1.2",
    "e2e": "^0.17.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "zod": "^4.1.8"
  }
}
